        "summary": "Search all accessible BookStack content",
        "description": "PRIMARY DISCOVERY OPERATION for documentation questions. Search all accessible books, chapters, pages and shelves using distinctive terms from the question. Results include type, id, title, and verified URL, but only a preview of content. For matching pages, call getPage with the returned page ID before answering. If results are weak, retry with a shorter or alternative term. Use pagination when needed.",
        "tags": [
          "Search"
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Short, distinctive BookStack search terms or phrase from the user question."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
